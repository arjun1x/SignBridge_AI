# SignBridge configuration. Copy to `.env` (git-ignored) or export in your shell.
# No value here is required for the public web build or for guest use of the
# desktop app; everything below is optional.

# --- Desktop app: Google sign-in (optional) -----------------------------------
# Create an OAuth client of type "Desktop app" at console.cloud.google.com →
# APIs & Services → Credentials. Google does not treat desktop-client secrets as
# confidential, but keep them out of git regardless. The desktop app reads these
# first and falls back to apps/desktop/resources/google-oauth.json
# ({"clientId": "...", "clientSecret": "..."}), which is git-ignored.
SIGNBRIDGE_GOOGLE_CLIENT_ID=
SIGNBRIDGE_GOOGLE_CLIENT_SECRET=

# --- Web build: asset CDN (optional) ------------------------------------------
# Leave empty to serve models/, mediapipe/ and ort/ from the site itself.
# Set to a separate origin (e.g. Cloudflare R2 behind a custom domain) when the
# host caps per-file size below 27 MB. The origin must send
# Access-Control-Allow-Origin and Cross-Origin-Resource-Policy: cross-origin.
# Read at build time by `npm run build:web` (Vite: VITE_ prefix, apps/web/.env*).
VITE_ASSET_BASE=

# --- Training pipeline (optional) ---------------------------------------------
# Kaggle API credentials are read from ~/.kaggle/kaggle.json by the kaggle CLI;
# never place them in the repository.
